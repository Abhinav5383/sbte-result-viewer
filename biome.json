{
	"$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
	"files": {
		"includes": [
			"**/*.{ts,tsx,js,jsx,css,html,json}",
			"!**/node_modules/*",
			"!**/dist/*",
			"!**/build/*",
			"!**/public/*"
		]
	},
	"formatter": {
		"lineWidth": 100,
		"indentStyle": "tab",
		"indentWidth": 4
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
