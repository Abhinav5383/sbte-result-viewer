{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"types": ["bun"],
		"paths": {
			"~/*": ["./src/*"],
			"@app/shared": ["../shared/src/index.ts"],
			"@app/shared/*": ["../shared/src/*"]
		}
	},
	"include": ["src", "db"],
	"exclude": ["node_modules", "dist"]
}
